<Window x:Class="BootLens.App.ActionConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="20" Padding="26" Effect="{DynamicResource SoftShadow}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource WarningSoft}"><TextBlock Text="!" Foreground="#B76B00" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" /><TextBlock x:Name="SubtitleText" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
            </StackPanel>
            <Border Background="{DynamicResource WarningSoft}" CornerRadius="12" Padding="14" Margin="0,22,0,18"><TextBlock x:Name="WarningText" Foreground="#805000" FontSize="11" TextWrapping="Wrap" /></Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="CurrentLabel" Foreground="{DynamicResource TextSecondary}" FontSize="10" /><TextBlock x:Name="CurrentText" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock x:Name="NextLabel" Foreground="{DynamicResource TextSecondary}" FontSize="10" /><TextBlock x:Name="NextText" Foreground="{DynamicResource AccentColor}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
            </Grid>
            <CheckBox x:Name="DontAskCheckBox" Content="{Binding DontAskText}" Margin="0,23,0,20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="{Binding CancelText}" Click="CancelButton_Click" Margin="0,0,9,0" /><Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" Click="ConfirmButton_Click" /></StackPanel>
        </StackPanel>
    </Border>
</Window>
